{
  "name": "livekadeh-ssh-sftp-desktop",
  "productName": "LiveKadeh SSH & SFTP Pro",
  "version": "1.5.0",
  "description": "Standalone Desktop Client for LiveKadeh SSH & SFTP Pro",
  "main": "main.js",
  "author": "livekadeh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/livekadeh/chrome-ssh-sftp-extension.git"
  },
  "scripts": {
    "sync": "node copy-assets.js",
    "prestart": "node copy-assets.js",
    "prebuild": "node copy-assets.js",
    "start": "electron .",
    "pack": "node copy-assets.js && electron-builder --dir",
    "build:win": "node copy-assets.js && electron-builder --win portable --publish never",
    "build:win:dir": "node copy-assets.js && electron-builder --win --dir",
    "build:linux": "node copy-assets.js && electron-builder --linux AppImage tar.gz --publish never",
    "build:mac": "node copy-assets.js && electron-builder --mac zip dmg --publish never",
    "build:all": "node copy-assets.js && electron-builder -wlm --publish never"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ssh2": "^1.15.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.livekadeh.sshsftp",
    "productName": "LiveKadeh SSH & SFTP Pro",
    "directories": {
      "output": "../dist"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/cpu-features/**",
      "**/node_modules/ssh2/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "splash-preload.js",
      "splash.bmp",
      "loading.gif",
      "loading.png",
      "icon.png",
      "extension/**/*",
      "server/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "LiveKadeh-SSH-SFTP-Portable-v${version}.exe",
      "splashImage": "splash.bmp"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "tar.gz",
          "arch": ["x64"]
        }
      ],
      "category": "Network",
      "artifactName": "LiveKadeh-SSH-SFTP-Linux-v${version}.${ext}",
      "icon": "icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "LiveKadeh-SSH-SFTP-Mac-${arch}-v${version}.${ext}",
      "icon": "icon.png"
    }
  }
}
